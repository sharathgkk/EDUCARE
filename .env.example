# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Set to the API origin only (no /api path) for production builds. Leave empty locally.
VITE_API_BASE_URL=""

# Comma-separated frontend origins allowed to call the API with session cookies.
CORS_ORIGINS="http://localhost:5173"

# Optional persistent data directory (Render uses /var/data).
EDUCARE_DATA_DIR=""

# Set a stable random secret in production. Do not commit this value.
SESSION_SECRET=""

# Nexconn Real-Time Chat SDK configuration
# Configure these in Settings > Secrets (or .env locally) without exposing NEXCONN_APP_SECRET to the browser.
NEXCONN_APP_KEY=""
NEXCONN_APP_SECRET=""
NEXCONN_AREA_CODE="SG"
VITE_NEXCONN_APP_KEY=""
